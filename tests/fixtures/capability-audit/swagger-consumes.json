{
  "swagger": "2.0",
  "info": {"title": "Swagger consumes audit", "version": "1"},
  "host": "root.example.invalid",
  "basePath": "/v1",
  "schemes": ["https"],
  "consumes": ["application/json"],
  "paths": {
    "/upload": {
      "post": {
        "operationId": "upload_binary",
        "consumes": ["application/octet-stream"],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {"type": "string", "format": "binary"}
          }
        ],
        "responses": {"204": {"description": "Uploaded"}}
      }
    },
    "/items": {
      "post": {
        "operationId": "create_item",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["name"],
              "properties": {"name": {"type": "string"}}
            }
          }
        ],
        "responses": {"204": {"description": "Created"}}
      }
    }
  }
}
